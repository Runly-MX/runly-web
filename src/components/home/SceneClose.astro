---
import { ArrowRight } from "@lucide/astro";
import type { HomeCopy } from "../../i18n/home-v2";
interface Props { c: HomeCopy; prefix: string }
const { c, prefix } = Astro.props;
const s = c.close;
---

<section class="hv2-close hv2-scroll-target" id={s.id} aria-labelledby="hv2-cl-title">
  <div class="hv2-wrap">
    <h2 id="hv2-cl-title" class="io">{s.lines.map((l) => <span>{l}</span>)}</h2>
    <p class="io">{s.body}</p>
    <div class="io mt-10 flex flex-wrap gap-3">
      <a href={`${prefix}/#contacto`} class="hv2-btn hv2-btn-dark">{s.ctaPrimary} <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
      <a href={s.ctaSecondaryHref} class="hv2-btn hv2-btn-line">{s.ctaSecondary}</a>
    </div>
  </div>
</section>
