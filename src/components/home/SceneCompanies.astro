---
import { Image } from "astro:assets";
import ModuleIcon from "./ModuleIcon.astro";
import isotipo from "../../assets/home-v2/isotipo-dark.png";
import type { HomeCopy } from "../../i18n/home-v2";
interface Props { c: HomeCopy }
const { c } = Astro.props;
const s = c.companies;
---

<section class="hv2-night hv2-scroll-target" id={s.id} aria-labelledby="hv2-co-title" data-scene="sticky">
  <div class="hv2-sticky" data-sticky>
    <div class="hv2-pin">
      <div class="hv2-wrap hv2-co-grid">
        <div>
          <p class="hv2-eyebrow">{s.eyebrow}</p>
          <h2 id="hv2-co-title" class="hv2-h2 mt-5" style="color:#fff">{s.title}</h2>
          <p class="hv2-lead mt-6">{s.body}</p>
          <ol class="hv2-steps">
            {s.steps.map((st, i) => (
              <li class="rv" style={`--s:${0.12 + i * 0.22};--dy:16px`}><b>{st.t}</b><span>{st.d}</span></li>
            ))}
          </ol>
          <p class="mt-6 text-sm" style="color:var(--rl-text-faint)">{s.note}</p>
        </div>
        <div>
          <div class="hv2-company-model" data-mobile-parallax>
            <div class="hv2-company-surface rv" style="--s:0.08;--dy:24px">
              <div class="hv2-company-masthead"><Image src={isotipo} alt={s.core} widths={[64, 128]} sizes="32px" format="webp" /><span>{s.workspace}</span><i aria-hidden="true"></i></div>
              <p class="hv2-company-kicker">{s.activeCompany}</p>
              <div class="hv2-company-identity"><span aria-hidden="true">{s.orgs[0].name[0]}</span><h3>{s.orgs[0].name}</h3></div>
              <p class="hv2-company-detail">{s.modulesLabel}</p>
              <ul class="hv2-company-modules" role="list">
                {s.orgs[0].mods.map((m) => <li><ModuleIcon name={m} size="md" /><span>{m}</span></li>)}
              </ul>
              <div class="hv2-company-foot"><span aria-hidden="true">01</span><p>{s.steps[1].d}</p></div>
            </div>
            <p class="hv2-company-others">{s.otherCompanies}</p>
            <ul class="hv2-company-list" role="list">
              {s.orgs.slice(1).map((o, i) => (
                <li class="rv" style={`--s:${0.35 + i * 0.2};--dy:20px`}>
                  <span class="hv2-company-avatar" aria-hidden="true">{o.name[0]}</span>
                  <div><b>{o.name}</b><span>{o.mods.join(" · ")}</span></div>
                  <span class="hv2-company-number" aria-hidden="true">0{i + 2}</span>
                </li>
              ))}
            </ul>
          </div>
          <p class="hv2-legend">{s.legend}</p>
        </div>
      </div>
    </div>
  </div>
</section>
