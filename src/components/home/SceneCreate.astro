---
import ShotSlot from "./ShotSlot.astro";
import { getHomeShot } from "./homeShots";
import type { HomeCopy } from "../../i18n/home-v2";
interface Props { c: HomeCopy }
const { c } = Astro.props;
const s = c.create;
const viewsByLayer: Record<string, { id: string; label: string }[]> = {
  studio: [
    { id: "HV2-04-editor", label: s.editorLabel },
    { id: "HV2-04", label: s.studioGallery },
  ],
  web: [
    { id: "HV2-06", label: s.editorLabel },
    { id: "HV2-06-preview", label: s.websitePreview },
  ],
};
const layers = s.layers.map((layer) => ({
  ...layer,
  views: viewsByLayer[layer.id]?.filter((view) => getHomeShot(view.id)) ?? [],
}));
---

<section class="hv2-create hv2-scroll-target" id={s.id} aria-labelledby="hv2-cr-title" data-scene="sticky">
  <div class="hv2-sticky">
    <div class="hv2-pin">
      <div class="hv2-wrap hv2-cr-grid">
        <div>
          <p class="hv2-eyebrow">{s.eyebrow}</p>
          <h2 id="hv2-cr-title" class="hv2-h2 mt-5">{s.title}</h2>
          <p class="hv2-lead mt-6">{s.body}</p>
        </div>
        <div class="hv2-layers">
          {layers.map((l, i) => (
            <div class="hv2-layer" data-i={i} style={`--s:${i === 0 ? 0 : 0.06 + i * 0.32};--e:${0.4 + i * 0.32}`}>
              <div class="hv2-layer-label"><b>{l.name}</b><span class="hv2-tag">{l.tag}</span></div>
              {l.views.length > 1 ? (
                <div data-tabs>
                  <div class="hv2-view-tabs" role="tablist" aria-label={l.name}>
                    {l.views.map((view, j) => (
                      <button type="button" role="tab" id={`tab-${view.id}`} aria-controls={`panel-${view.id}`} aria-selected={j === 0 ? "true" : "false"} tabindex={j === 0 ? 0 : -1}>{view.label}</button>
                    ))}
                  </div>
                  {l.views.map((view) => (
                    <div class="hv2-panel" id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} data-panel>
                      <ShotSlot slotId={view.id} label={view.label} alt={`${l.name}: ${view.label}`} ratio="16 / 9" />
                    </div>
                  ))}
                </div>
              ) : l.id === "auto" && !getHomeShot(l.id2) ? (
                <figure class="hv2-frame">
                  <div class="hv2-frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{s.flowLegend}</span></div>
                  <div class="hv2-flow" role="img" aria-label={`${s.flowLegend}: ${s.flow.map((f, k) => `${f} - ${s.flowSample[k]}`).join(" > ")}`}>
                    {s.flow.map((f, k) => <div><i>{f}</i><span>{s.flowSample[k]}</span></div>)}
                  </div>
                </figure>
              ) : (
                <ShotSlot slotId={l.views[0]?.id ?? l.id2} label={l.name} pendingText={c.modules.pendingTag} ratio="16 / 9" />
              )}
              <p>{l.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
