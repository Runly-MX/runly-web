---
import { ArrowRight } from "@lucide/astro";
import type { HomeCopy } from "../../i18n/home-v2";
interface Props { c: HomeCopy }
const { c } = Astro.props;
const s = c.market;
---

<section class="hv2-market hv2-scroll-target" id={s.id} aria-labelledby="hv2-mk-title">
  <div class="hv2-wrap">
    <p class="hv2-eyebrow io">{s.eyebrow}</p>
    <h2 id="hv2-mk-title" class="hv2-h2 io mt-5 max-w-3xl">{s.title}</h2>
    <p class="hv2-lead io mt-6">{s.body}</p>
    <div class="hv2-mk-grid" data-tabs>
      <div class="hv2-tablist hv2-mk-list" role="tablist" aria-label={s.eyebrow} aria-orientation="vertical">
        {s.kinds.map((k, i) => (
          <button type="button" role="tab" class="hv2-tab" id={`hv2-mk-tab-${k.id}`} aria-controls={`hv2-mk-panel-${k.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span>{k.name}</span><small>0{i + 1}</small>
          </button>
        ))}
      </div>
      <div>
        {s.kinds.map((k, i) => (
          <div class="hv2-panel hv2-mk-stage" role="tabpanel" id={`hv2-mk-panel-${k.id}`} aria-labelledby={`hv2-mk-tab-${k.id}`} data-panel>
            <span class="big" aria-hidden="true">0{i + 1}</span>
            <p><span class="hv2-tag">{s.status}: {k.status}</span></p>
            <p><b style="color:var(--rl-text)">{k.name}.</b> {k.text}</p>
          </div>
        ))}
        <a href="/marketplace/" class="hv2-btn hv2-btn-primary mt-8">{s.cta} <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
        <p class="mt-3 text-sm" style="color:var(--rl-text-faint)">{s.ctaNote}</p>
      </div>
    </div>
  </div>
</section>
