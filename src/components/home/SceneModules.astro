---
import { ArrowRight } from "@lucide/astro";
import ShotSlot from "./ShotSlot.astro";
import ModuleIcon from "./ModuleIcon.astro";
import inicio from "../../assets/tour/inicio.png";
import { getHomeShot } from "./homeShots";
import type { HomeCopy } from "../../i18n/home-v2";
interface Props { c: HomeCopy }
const { c } = Astro.props;
const s = c.modules;
const areas = s.areas.map((area) => ({
  ...area,
  capture: getHomeShot(area.id2) ?? (area.real ? inicio : undefined),
}));
---

<section class="hv2-modules hv2-scroll-target" id={s.id} aria-labelledby="hv2-mod-title">
  <div class="hv2-wrap">
    <p class="hv2-eyebrow io">{s.eyebrow}</p>
    <h2 id="hv2-mod-title" class="hv2-h2 io mt-5 max-w-3xl">{s.title}</h2>
    <p class="hv2-lead io mt-6">{s.body}</p>
    <div class="hv2-mod-grid" data-tabs>
      <div class="hv2-tablist" role="tablist" aria-label={s.eyebrow} aria-orientation="vertical">
        {s.areas.map((a, i) => (
          <button type="button" role="tab" class="hv2-tab" id={`hv2-tab-${a.id}`} aria-controls={`hv2-panel-${a.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span>{a.name}</span><small>0{i + 1}</small>
          </button>
        ))}
      </div>
      <div>
        {areas.map((a) => (
          <div class="hv2-panel" role="tabpanel" id={`hv2-panel-${a.id}`} aria-labelledby={`hv2-tab-${a.id}`} data-panel>
            <ShotSlot slotId={a.id2} label={a.name} alt={a.real ? c.hero.shotAlt : ""} src={a.capture} pendingText={s.pendingTag} ratio="16 / 9.6" />
            <p class="txt">{a.text}</p>
            <ul class="hv2-links" aria-label={a.name}>{a.links.map((l) => <li><ModuleIcon name={l} />{l}</li>)}</ul>
            <p class="mt-3"><span class="hv2-tag">{a.capture ? s.realTag : s.pendingTag}</span></p>
          </div>
        ))}
        <a href={s.ctaHref} class="hv2-btn hv2-btn-ghost mt-10">{s.cta} <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>
