---
// Product screenshot frame. With `src` it renders the real image (astro:assets,
// stable ratio, lazy by default). Without it, an intentional placeholder keyed
// by its capture ID (docs/home-v2/VISUAL-ASSETS.md) so the real screenshot can
// replace it with no layout change. Never fakes a UI.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  slotId: string;
  label: string;
  alt?: string;
  src?: ImageMetadata;
  ratio?: string;
  pendingText?: string;
  eager?: boolean;
  sizes?: string;
  chrome?: boolean;
}
const { slotId, label, alt = "", src, ratio = "16 / 10", pendingText = "", eager = false, sizes = "(min-width: 1024px) 56vw, 100vw", chrome = true } = Astro.props;
---

<figure class="hv2-frame" data-slot={slotId} data-real={src ? "true" : "false"}>
  {chrome && (
    <div class="hv2-frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{label}</span></div>
  )}
  {src ? (
    <Image src={src} alt={alt} widths={[640, 960, 1400]} sizes={sizes} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} format="webp" quality={82} style={`aspect-ratio:${ratio}`} />
  ) : (
    <div class="hv2-slot" style={`--ratio:${ratio}`} role="img" aria-label={`${label}. ${pendingText}`}>
      <div><b>{label}</b><span>{pendingText} · {slotId}</span></div>
    </div>
  )}
</figure>
