---
// src/components/layout/SiteHead.astro
import { SITE_URL, SITE_NAME, COMPANY_NAME } from "../../consts";
import { getImage } from "astro:assets";
import appIcon from "../../../public/brand/runly-app-icon-light.png";

interface Props {
  title: string;
  description: string;
  locale: "es" | "en";
  path: string; // must start with "/", e.g. "/" or "/modulos" — without locale prefix
  hasEnglish?: boolean;
  // Pages that must stay out of search results (e.g. unlisted/runtime-resolved modules).
  noindex?: boolean;
}

const { title, description, locale, path, noindex } = Astro.props;

if (!path.startsWith("/")) {
  throw new Error(`SiteHead "path" prop must start with "/", received: "${path}"`);
}

// Pages are built as directories (/foo/index.html) and nginx 301s "/foo" to "/foo/",
// so canonical/hreflang/og:url must carry the trailing slash to match the sitemap.
const esPath = path.endsWith("/") ? path : `${path}/`;
const enPath = `/en${esPath}`;
// Documentation is Spanish-only: no /en/documentacion/* pages exist, so advertising them would point crawlers at 404s.
const hasEnglish = Astro.props.hasEnglish ?? !esPath.startsWith("/documentacion/");
const canonicalPath = locale === "es" ? esPath : enPath;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const esUrl = new URL(esPath, SITE_URL).toString();
const enUrl = new URL(enPath, SITE_URL).toString();

const ogImagePath = locale === "es" ? "/brand/og-cover-es.png" : "/brand/og-cover-en.png";
const ogImageUrl = new URL(ogImagePath, SITE_URL).toString();
const favicon = await getImage({ src: appIcon, width: 32, height: 32, format: "png" });
const touchIcon = await getImage({ src: appIcon, width: 180, height: 180, format: "png" });

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: COMPANY_NAME,
      url: "https://racoondevs.com",
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: SITE_URL,
      description,
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script is:inline>
  // Runs before first paint: apply the saved/system theme so there is no flash.
  (function () {
    var v;
    try { v = localStorage.getItem("runly.theme"); } catch (e) {}
    var d = v === "dark" || (v !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.dataset.theme = d ? "dark" : "light";
  })();
</script>
<meta name="color-scheme" content="light dark" />
<noscript><style>[data-theme-cycle], [data-theme-toggle], #mobileMenuBtn { display: none !important; }</style></noscript>
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />
{hasEnglish && (
  <>
    <link rel="alternate" hreflang="es-MX" href={esUrl} />
    <link rel="alternate" hreflang="en-US" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={locale === "es" ? "es_MX" : "en_US"} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />

<link rel="icon" type="image/png" href={favicon.src} />
<link rel="apple-touch-icon" href={touchIcon.src} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
