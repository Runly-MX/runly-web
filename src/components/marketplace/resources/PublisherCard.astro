---
// src/components/marketplace/resources/PublisherCard.astro
import { publisherPath } from "../../../lib/marketplace-resources/routes";
import { T } from "../../../lib/marketplace-resources/text";
import type { PublisherRef } from "../../../lib/marketplace-resources/types";

interface Props { publisher: PublisherRef; count: number }
const { publisher, count } = Astro.props;
const initials = publisher.displayName.split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? "").join("");
---

<a href={publisherPath(publisher.handle)} class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition-colors hover:border-orange-300 hover:bg-orange-50/40">
  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white" aria-hidden="true">{initials}</span>
  <span class="min-w-0">
    <span class="block truncate font-bold text-slate-900">{publisher.displayName}</span>
    <span class="block text-xs text-slate-500">{T.results(count)}{publisher.verified ? ` · ${T.verifiedPublisher}` : ""}</span>
  </span>
</a>
