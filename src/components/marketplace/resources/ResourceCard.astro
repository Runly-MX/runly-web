---
// src/components/marketplace/resources/ResourceCard.astro
//
// One catalog card. Data attributes feed the client-side filter in
// ResourceCatalog.astro (search text is precomputed by searchKey()).
import MarketplaceTrustBadge from "../MarketplaceTrustBadge.astro";
import { resolveIcon } from "../../../lib/icons";
import { categoryLabel, searchKey } from "../../../lib/marketplace-resources/filters";
import { hasStaticPage, resourcePath, runtimeResourcePath } from "../../../lib/marketplace-resources/routes";
import { previewUrl } from "../../../lib/marketplace-resources/client";
import { T, TYPE_TEXT } from "../../../lib/marketplace-resources/text";
import type { DataSource, ResourceSummary, ResourceType } from "../../../lib/marketplace-resources/types";

interface Props { resource: ResourceSummary; source: DataSource }
const { resource: r, source } = Astro.props;
const ICON: Record<ResourceType, string> = { studio_template: "Palette", automation: "Workflow", website_template: "Globe", solution: "Package" };
const TINT: Record<ResourceType, string> = { studio_template: "bg-violet-50 text-violet-700", automation: "bg-amber-50 text-amber-700", website_template: "bg-sky-50 text-sky-700", solution: "bg-emerald-50 text-emerald-700" };
const COVER: Record<ResourceType, string> = { studio_template: "from-violet-100 to-violet-50 text-violet-700", automation: "from-amber-100 to-amber-50 text-amber-700", website_template: "from-sky-100 to-sky-50 text-sky-700", solution: "from-emerald-100 to-emerald-50 text-emerald-700" };
const Icon = resolveIcon(ICON[r.type]);
const href = hasStaticPage(source, r) ? resourcePath(r.type, r.slug) : runtimeResourcePath(r.type, r.slug);
const unavailable = r.availability !== "available";
// Only what the parser admitted (raster images on the Hub preview route); never sample images.
const preview = r.previews[0] ?? null;
const hub = import.meta.env.PUBLIC_RUNLY_HUB_URL;
---

<article
  class={`mk-card group relative flex h-full flex-col gap-3 rounded-3xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-glass focus-within:border-orange-400 ${unavailable ? "opacity-80" : ""}`}
  data-type={r.type}
  data-trust={r.trust}
  data-categories={r.categories.join("|")}
  data-search={searchKey(r)}
  data-availability={r.availability}
>
  <div class={`relative -mx-1 -mt-1 aspect-[16/10] overflow-hidden rounded-2xl border border-slate-100 ${preview ? "bg-slate-50" : `bg-gradient-to-br ${COVER[r.type]}`}`} data-mk-preview>
    {preview && <img src={previewUrl(hub, preview)} alt={preview.alt} width={preview.width} height={preview.height} loading="lazy" decoding="async" class="h-full w-full object-contain transition-transform duration-300 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />}
    {/* Fallback cover: type icon only (never an invented screenshot). Also shown when the preview fails to load. */}
    <span hidden={!!preview} data-mk-preview-fallback class={`absolute inset-0 flex items-center justify-center ${preview ? TINT[r.type] : ""}`}><Icon class="h-10 w-10 opacity-80" aria-hidden="true" /></span>
    <span class="absolute left-2.5 top-2.5 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200/70"><Icon class="h-3 w-3" aria-hidden="true" />{TYPE_TEXT[r.type].singular}</span>
  </div>
  <div class="min-w-0">
    <h3 class="font-bold leading-snug text-slate-900">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus:outline-none group-hover:text-orange-600">{r.title}</a>
    </h3>
    <p class="mt-0.5 text-xs text-slate-500">{T.by} {r.publisher.displayName}{r.latest ? ` · ${T.version(r.latest.version)}` : ""}</p>
  </div>
  <p class="line-clamp-3 flex-1 text-sm text-slate-600">{r.summary}</p>
  <div class="flex flex-wrap items-center gap-1.5">
    <MarketplaceTrustBadge trust={r.trust} locale="es" />
    {unavailable && r.trust !== "revoked" && <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ring-inset ${r.availability === "revoked" ? "bg-red-50 text-red-700 ring-red-200" : "bg-amber-50 text-amber-800 ring-amber-200"}`} data-slot="availability">{T.availability[r.availability]}</span>}
  </div>
  <p class="text-[11px] text-slate-500">
    {r.categories[0] && <span class="font-semibold text-slate-600">{categoryLabel(r.categories[0])} · </span>}
    {r.compatibility && <span>{T.detail.requiresRunly(r.compatibility.runly.min, r.compatibility.runly.max)} · </span>}
    {T.licenseLabel}: {r.license} · {T.locale[r.locale]}
  </p>
</article>

<script>
  // A preview that fails to load falls back to the type icon (the alt text stays on the image).
  const fallback = (img: HTMLImageElement) => {
    const box = img.closest<HTMLElement>("[data-mk-preview]");
    if (!box || box.dataset.failed) return;
    box.dataset.failed = "true";
    img.hidden = true;
    box.querySelector("[data-mk-preview-fallback]")?.removeAttribute("hidden");
  };
  document.addEventListener("error", (event) => { if (event.target instanceof HTMLImageElement) fallback(event.target); }, true);
  document.querySelectorAll<HTMLImageElement>("[data-mk-preview] img").forEach((img) => { if (img.complete && img.naturalWidth === 0) fallback(img); });
</script>
