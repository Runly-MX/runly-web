---
// src/components/sections/ImplementationSection.astro
import { MessagesSquare, LayoutTemplate, Rocket, TrendingUp } from "@lucide/astro";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { implementation } = dict;

// One icon per step, by position — the dict only stores number/title/description
// (shared with anything else that might reuse this content), so the icon choice
// lives here instead of in translation data.
const stepIcons = [MessagesSquare, LayoutTemplate, Rocket, TrendingUp];
---

<section class="py-24 bg-slate-50 border-b border-slate-200 relative overflow-hidden" id="implementacion">
  <div data-parallax="0.1" class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-orange-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-xs font-bold uppercase tracking-wider mb-3">{implementation.badge}</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">{implementation.title}</h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">{implementation.description}</p>
    </div>

    <div class="bento-stagger reveal-on-scroll grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      {implementation.steps.map((step, i) => {
        const Icon = stepIcons[i] ?? Rocket;
        return (
          <div class="group bg-white p-6 rounded-2xl border border-slate-200 relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-orange-200">
            <span aria-hidden="true" class="text-4xl font-black text-orange-500/10 absolute top-4 right-4 transition-colors duration-300 group-hover:text-orange-500/25">{step.number}</span>
            <div class="relative z-10 w-11 h-11 rounded-xl bg-gradient-to-br from-slate-900 to-slate-700 text-white flex items-center justify-center mb-4 shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3">
              <Icon class="w-5 h-5" />
            </div>
            <h3 class="relative z-10 text-base font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="relative z-10 text-xs text-slate-600 leading-relaxed">{step.description}</p>
          </div>
        );
      })}
    </div>

    <div class="rounded-3xl p-8 sm:p-10 bg-white border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8 reveal-on-scroll">
      <div class="max-w-2xl">
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">{implementation.valueTitle}</h3>
        <p class="text-sm text-slate-600 leading-relaxed">{implementation.valueDescription}</p>
      </div>
      <div class="shrink-0">
        <a class="inline-flex items-center gap-2 px-8 py-4 rounded-xl text-white font-semibold text-base runly-gradient-btn shadow-md transition-transform hover:-translate-y-0.5" href="#contacto">{implementation.valueCta} &rarr;</a>
      </div>
    </div>
  </div>
</section>
