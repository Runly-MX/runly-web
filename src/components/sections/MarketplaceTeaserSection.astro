---
// src/components/sections/MarketplaceTeaserSection.astro
//
// Home discovery block for the Marketplace. Static copy only: it describes the
// kinds of resources and never states counts or names of resources that may not
// exist (the live catalog is on /marketplace). Spanish-only target pages.
import { Palette, Workflow, Globe, Package, ArrowRight } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";

const kinds = [
  { icon: Palette, label: "Plantillas Studio", text: "Documentos, etiquetas y diseños.", tint: "bg-violet-50 text-violet-700" },
  { icon: Workflow, label: "Automatizaciones", text: "Flujos que se importan en pausa.", tint: "bg-amber-50 text-amber-700" },
  { icon: Globe, label: "Plantillas Website", text: "Sitios completos como borrador.", tint: "bg-sky-50 text-sky-700" },
  { icon: Package, label: "Solutions", text: "Combinaciones para un caso de uso.", tint: "bg-emerald-50 text-emerald-700" },
];
---

<section class="bg-slate-50 py-24" id="marketplace">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="Marketplace" title="Recursos listos para usar en Runly" description="Además de los módulos oficiales, Runly tiene un Marketplace de plantillas, automatizaciones y Solutions publicadas por Runly y por la comunidad. Se instalan desde dentro de Runly, donde cada recurso se revisa antes de aplicarse." />
    <ul class="mb-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {kinds.map(({ icon: Icon, label, text, tint }) => (
        <li class="rounded-3xl border border-slate-200 bg-white p-5">
          <span class={`flex h-11 w-11 items-center justify-center rounded-2xl ${tint}`}><Icon class="h-5 w-5" aria-hidden="true" /></span>
          <p class="mt-3 font-bold text-slate-900">{label}</p>
          <p class="mt-1 text-sm text-slate-600">{text}</p>
        </li>
      ))}
    </ul>
    <div class="flex justify-center">
      <a href="/marketplace/" class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md runly-gradient-btn">
        Explorar el Marketplace <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
