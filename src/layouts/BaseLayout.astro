---
// src/layouts/BaseLayout.astro
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "../styles/global.css";
import SiteHead from "../components/layout/SiteHead.astro";
import ChatWidgetIsland from "../components/ChatWidgetIsland";

interface Props {
  title: string;
  description: string;
  locale: "es" | "en";
  path: string;
  hasEnglish?: boolean;
  noindex?: boolean;
}

const { title, description, locale, path, hasEnglish, noindex } = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <SiteHead title={title} description={description} locale={locale} path={path} hasEnglish={hasEnglish} noindex={noindex} />
  </head>
  <body class="bg-[var(--rl-bg)] text-slate-800 font-sans antialiased selection:bg-orange-500 selection:text-white overflow-x-hidden">
    <slot />
    <noscript>
      <style>
        .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      try {
        if ("IntersectionObserver" in window) {
          const observerOptions = { root: null, rootMargin: "0px 0px -60px 0px", threshold: 0.1 };
          const revealObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          }, observerOptions);
          document.querySelectorAll(".reveal-on-scroll").forEach((el) => revealObserver.observe(el));
        } else {
          document.querySelectorAll(".reveal-on-scroll").forEach((el) => el.classList.add("is-visible"));
        }
      } catch {
        document.querySelectorAll(".reveal-on-scroll").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
    <script>
      // Theme control: "system" | "light" | "dark". The early inline script in
      // SiteHead already applied data-theme; this wires every [data-theme-toggle].
      const KEY = "runly.theme";
      const mq = window.matchMedia("(prefers-color-scheme: dark)");
      const read = () => { try { const v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : "system"; } catch { return "system"; } };
      const apply = (pref: string) => {
        const root = document.documentElement;
        root.classList.add("rl-theme-switching");
        root.dataset.theme = pref === "system" ? (mq.matches ? "dark" : "light") : pref;
        root.dataset.themePref = pref;
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("rl-theme-switching")));
        document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle] button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === pref)));
      };
      apply(read());
      document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-value]");
          if (!btn) return;
          const v = btn.dataset.value!;
          try { if (v === "system") localStorage.removeItem(KEY); else localStorage.setItem(KEY, v); } catch {}
          apply(v);
        });
      });
      document.querySelectorAll<HTMLElement>("[data-theme-cycle]").forEach((b) => b.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem(KEY, next); } catch {}
        apply(next);
      }));
      mq.addEventListener("change", () => { if (read() === "system") apply("system"); });
      window.addEventListener("storage", (e) => { if (e.key === KEY) apply(read()); });
    </script>
    <script>
      // Subtle scroll parallax for decorative background blobs
      // (data-parallax="<speed>" on the blurred/gradient blobs used across
      // sections). Offset is relative to each element's distance from the
      // viewport's vertical center, not raw page scroll — bounded and
      // self-correcting regardless of how far down the page it sits, and
      // clipped by each section's own overflow-hidden. Transform/opacity
      // only, respects prefers-reduced-motion, never touches anything
      // interactive or text-bearing.
      try {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
        if (!prefersReducedMotion && parallaxEls.length) {
          let ticking = false;
          const update = () => {
            const viewportCenter = window.innerHeight / 2;
            parallaxEls.forEach((el) => {
              const speed = parseFloat(el.dataset.parallax || "0.15");
              const rect = el.getBoundingClientRect();
              const distanceFromCenter = rect.top + rect.height / 2 - viewportCenter;
              el.style.transform = `translateY(${(distanceFromCenter * -speed).toFixed(1)}px)`;
            });
            ticking = false;
          };
          const requestUpdate = () => {
            if (!ticking) {
              ticking = true;
              window.requestAnimationFrame(update);
            }
          };
          window.addEventListener("scroll", requestUpdate, { passive: true });
          window.addEventListener("resize", requestUpdate);
          update();
        }
      } catch {
        // Parallax is decorative only — silently skip on any failure.
      }
    </script>
    <script>
      // Runly Growth analytics — no-ops when PUBLIC_RUNLY_API_URL/COMPANY
      // aren't configured. Respects the site's analyticsMode (off /
      // anonymous / consent_required) as set in Growth → Sitios conectados;
      // this site has no cookie-consent banner yet, so we never call
      // setConsent() ourselves — see README's Contact form / analytics notes.
      import { runlySdk } from "../lib/runly-sdk";
      runlySdk?.analytics.start().catch(() => {});
    </script>
    <!--
      Guest live chat (runly.chat module via Growth). Renders nothing when
      PUBLIC_RUNLY_* isn't configured, or when the ERP reports the chat
      service unavailable/not installed — see ChatWidgetIsland.tsx.
      client:idle: not critical to first paint, hydrate once the browser
      is idle.
    -->
    <ChatWidgetIsland client:idle />
  </body>
</html>
