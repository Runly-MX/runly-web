---
// src/pages/documentacion/modulos/[modulo].astro
//
// One page per module: a header tinted with the module's color, its overview
// and a section per documented view (in sidebar order, with its in-app icon),
// plus a sticky "on this page" index. Renders the markdown body via Astro's
// built-in content rendering (render()), not a hand-rolled parser — see
// docs/superpowers/specs/2026-09-27-public-help-docs-runly-web-design.md
// in the runly repo.
export const prerender = true;

import { getCollection, render } from "astro:content";
import { ArrowLeft, ArrowRight, BookOpen, Sparkles, ChevronRight, Hash, Route } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/layout/Header.astro";
import Footer from "../../../components/layout/Footer.astro";
import DocsSearch from "../../../components/docs/DocsSearch.astro";
import DocsSearchTrigger from "../../../components/docs/DocsSearchTrigger.astro";
import DocsToc from "../../../components/docs/DocsToc.astro";
import { getDictionary } from "../../../i18n";
import { moduleCategories } from "../../../data/modules";
import capabilitiesByModule from "../../../data/module-capabilities.json";
import { resolveIcon } from "../../../lib/icons";
import { getDocsCatalog, resolveGuides, moduleDocHref, guideHref } from "../../../lib/docs-content";

export async function getStaticPaths() {
  const catalog = await getDocsCatalog();
  return catalog.map((mod) => ({ params: { modulo: mod.moduleKey }, props: { moduleKey: mod.moduleKey } }));
}

const { moduleKey } = Astro.props;
const catalog = await getDocsCatalog();
const index = catalog.findIndex((m) => m.moduleKey === moduleKey);
const mod = catalog[index];
const prev = catalog[index - 1];
const next = catalog[index + 1];

const entries = await getCollection("help", (e) => e.id.startsWith(`${moduleKey}/`));
const overviewEntry = entries.find((e) => e.id === `${moduleKey}/overview`);
const Overview = overviewEntry ? (await render(overviewEntry)).Content : null;
const views = await Promise.all(
  mod.views.map(async (view) => {
    const entry = entries.find((e) => e.id === `${moduleKey}/views/${view.slug}`)!;
    return { ...view, Content: (await render(entry)).Content };
  }),
);

const guides = resolveGuides(catalog).filter((g) => g.resolvedSteps.some((s) => s.module.moduleKey === moduleKey));
const category = moduleCategories.find((c) => c.id === mod.category);
const Icon = resolveIcon(mod.icon);

const caps = (capabilitiesByModule as Record<string, { highlights: { icon: string; title: string; text: string }[]; compat?: string[] }>)[moduleKey];

const toc = [
  ...(caps ? [{ id: "capacidades", title: "Lo que puedes hacer", icon: "Sparkles" }] : []),
  ...(Overview ? [{ id: "resumen", title: "Descripción general", icon: "BookOpen" }] : []),
  ...views.map((v) => ({ id: v.slug, title: v.title, icon: v.icon })),
];

const locale = "es" as const;
const dict = getDictionary(locale);
---

<BaseLayout
  title={`${mod.name} — Documentación de Runly`}
  description={mod.summary || `Documentación del módulo ${mod.name}.`}
  locale={locale}
  path={moduleDocHref(moduleKey)}
>
  <Header locale={locale} nav={dict.nav} />
  <main class="bg-white" style={`--mod:${mod.color}`}>
    <!-- Module header -->
    <header class="relative overflow-hidden border-b border-slate-100 pb-10 pt-24 sm:pt-28">
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse at 15% 0%, color-mix(in srgb, var(--mod) 14%, transparent), transparent 60%), linear-gradient(to bottom, color-mix(in srgb, var(--mod) 5%, white), white);"
        aria-hidden="true"
      >
      </div>
      <div class="bg-grid-pattern absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <nav aria-label="Ruta" class="flex flex-wrap items-center gap-1 text-xs font-semibold text-slate-500">
          <a href="/documentacion/modulos" class="hover:text-slate-900">Documentación</a>
          <ChevronRight class="h-3.5 w-3.5" />
          <a href="/documentacion/modulos#modulos" class="hover:text-slate-900">{category?.label.es ?? "Módulos"}</a>
          <ChevronRight class="h-3.5 w-3.5" />
          <span class="mod-text">{mod.name}</span>
        </nav>

        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
          <span class="mod-tile flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl">
            <Icon class="h-8 w-8" />
          </span>
          <div class="min-w-0">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{mod.name}</h1>
            {mod.summary && <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-600">{mod.summary}</p>}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2 text-xs font-semibold">
          {category && <span class="mod-soft rounded-full px-3 py-1">{category.label.es}</span>}
          <span class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200">{views.length} pestañas</span>
          {mod.version && <span class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200">v{mod.version}</span>}
          <code class="rounded-full bg-white px-3 py-1 font-mono text-slate-500 ring-1 ring-slate-200">{mod.moduleKey}</code>
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:px-8">
      <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto">
        <DocsSearchTrigger />
        <DocsToc items={toc} class="mt-6 hidden lg:block" />
        {guides.length > 0 && (
          <div class="mt-6 hidden border-t border-slate-100 pt-5 lg:block">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400">Aparece en las guías</p>
            <ul class="mt-2 space-y-1">
              {guides.map((guide) => (
                <li>
                  <a href={guideHref(guide.slug)} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900">
                    <Route class="h-3.5 w-3.5 text-orange-500" />
                    {guide.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>

      <article class="min-w-0">
        {views.length > 0 && (
          <nav aria-label="Pestañas de este módulo" class="grid gap-2 sm:grid-cols-2">
            {views.map((view) => {
              const ViewIcon = resolveIcon(view.icon);
              return (
                <a
                  href={`#${view.slug}`}
                  class="doc-card group flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3"
                >
                  <span class="mod-soft flex h-9 w-9 shrink-0 items-center justify-center rounded-lg">
                    <ViewIcon class="h-4 w-4" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-bold text-slate-900">{view.title}</span>
                    <span class="line-clamp-2 block text-xs leading-relaxed text-slate-500">{view.summary}</span>
                  </span>
                </a>
              );
            })}
          </nav>
        )}

        {caps && (
          <section id="capacidades" class="doc-section mt-12 scroll-mt-24">
            <h2 class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
              <Sparkles class="mod-text h-5 w-5" />
              Lo que puedes hacer
            </h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {caps.highlights.map((cap) => {
                const CapIcon = resolveIcon(cap.icon);
                return (
                  <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
                    <span class="mod-soft flex h-9 w-9 shrink-0 items-center justify-center rounded-lg"><CapIcon class="h-4 w-4" /></span>
                    <div class="min-w-0">
                      <h3 class="text-sm font-bold text-slate-900">{cap.title}</h3>
                      <p class="mt-0.5 text-xs leading-relaxed text-slate-600">{cap.text}</p>
                    </div>
                  </div>
                );
              })}
            </div>
            {caps.compat && (
              <div class="mt-5">
                <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400">Compatibilidades y formatos</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {caps.compat.map((c) => <li class="mod-soft rounded-full px-3 py-1 text-xs font-semibold">{c}</li>)}
                </ul>
              </div>
            )}
          </section>
        )}

        {Overview && (
          <section id="resumen" class="doc-section mt-12 scroll-mt-24">
            <h2 class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
              <BookOpen class="mod-text h-5 w-5" />
              Descripción general
            </h2>
            <div class="doc-prose mt-4">
              <Overview />
            </div>
          </section>
        )}

        {views.map((view) => {
          const ViewIcon = resolveIcon(view.icon);
          return (
            <section id={view.slug} class="doc-section mt-14 scroll-mt-24 border-t border-slate-100 pt-10">
              <div class="group flex items-start gap-3">
                <span class="mod-tile flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
                  <ViewIcon class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <h2 class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
                    {view.title}
                    <a
                      href={`#${view.slug}`}
                      class="text-slate-300 opacity-0 transition group-hover:opacity-100 hover:text-slate-500 focus:opacity-100"
                      aria-label={`Enlace a ${view.title}`}
                    >
                      <Hash class="h-4 w-4" />
                    </a>
                  </h2>
                  <p class="mt-0.5 text-sm text-slate-500">{view.summary}</p>
                </div>
              </div>
              <div class="doc-prose mt-5">
                <view.Content />
              </div>
            </section>
          );
        })}

        <nav aria-label="Otros módulos" class="mt-16 grid gap-3 border-t border-slate-100 pt-8 sm:grid-cols-2">
          {prev ? (
            <a href={moduleDocHref(prev.moduleKey)} class="doc-card group rounded-xl border border-slate-200 p-4" style={`--mod:${prev.color}`}>
              <span class="flex items-center gap-1 text-xs font-semibold text-slate-400"><ArrowLeft class="h-3.5 w-3.5" /> Anterior</span>
              <span class="mod-text mt-1 block font-bold">{prev.name}</span>
            </a>
          ) : <span />}
          {next && (
            <a href={moduleDocHref(next.moduleKey)} class="doc-card group rounded-xl border border-slate-200 p-4 text-right" style={`--mod:${next.color}`}>
              <span class="flex items-center justify-end gap-1 text-xs font-semibold text-slate-400">Siguiente <ArrowRight class="h-3.5 w-3.5" /></span>
              <span class="mod-text mt-1 block font-bold">{next.name}</span>
            </a>
          )}
        </nav>
      </article>
    </div>
  </main>
  <Footer locale={locale} footer={dict.footer} />
  <DocsSearch />
</BaseLayout>
