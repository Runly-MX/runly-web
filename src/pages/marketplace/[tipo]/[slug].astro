---
// src/pages/marketplace/[tipo]/[slug].astro
//
// On-demand details keep stable URLs and current HTTP availability after publication.
import ResourceStateBlock from "../../../components/marketplace/resources/ResourceStateBlock";
import { typeFromSegment } from "../../../lib/marketplace-resources/routes";
import CatalogShell from "../../../components/marketplace/resources/CatalogShell.astro";
import ResourceDetailView from "../../../components/marketplace/resources/ResourceDetailView";
import { pageIsIndexable } from "../../../lib/marketplace-resources/routes";
import { indexingAuthorized, getBuildSource, sourceKind } from "../../../lib/marketplace-resources/source";

export const prerender = false;
const type = typeFromSegment(Astro.params.tipo);
const result = type ? await (await getBuildSource()).detail(type, Astro.params.slug ?? '') : { status: 'not_found' as const };
const resource = result.status === 'ok' ? result.resource : null;
const source = sourceKind();
Astro.response.status = result.status === 'not_found' ? 404 : result.status === 'gone' ? 410 : result.status === 'unavailable' ? 503 : 200;
Astro.response.headers.set('Cache-Control', 'no-store');
const kind = result.status === 'gone' ? result.availability === 'revoked' ? 'revoked' : 'withdrawn' : result.status === 'not_found' ? 'not_found' : 'unavailable';

---

<CatalogShell
  title={`${resource?.title ?? "Recurso"} | Marketplace RUNLY`}
  description={resource?.summary ?? "Recurso del Marketplace de Runly."}
  path={Astro.url.pathname.replace(/\/$/, "")}
  source={source}
  noindex={!resource || !pageIsIndexable(source, indexingAuthorized(), resource)}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    {resource ? <ResourceDetailView resource={resource} hubUrl={import.meta.env.PUBLIC_RUNLY_HUB_URL} checkLive={source === "hub"} client:load /> : <ResourceStateBlock kind={kind} replacement={result.status === "gone" ? result.replacement : null} showBack />}
  </div>
</CatalogShell>
