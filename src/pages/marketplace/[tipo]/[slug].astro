---
// src/pages/marketplace/[tipo]/[slug].astro
//
// Static detail page per resource (listed + indexable + available in production;
// every fixture in local preview). Everything else resolves at runtime on
// /marketplace/detalle/ (noindex).
import CatalogShell from "../../../components/marketplace/resources/CatalogShell.astro";
import ResourceDetailView from "../../../components/marketplace/resources/ResourceDetailView";
import { typesWithResources } from "../../../lib/marketplace-resources/filters";
import { TYPE_SEGMENT, hasStaticPage, pageIsIndexable, resourcePath } from "../../../lib/marketplace-resources/routes";
import { getBuildSource, loadCatalogForBuild, sourceKind } from "../../../lib/marketplace-resources/source";
import type { ResourceDetail } from "../../../lib/marketplace-resources/types";

export const prerender = true;

export async function getStaticPaths() {
  const list = await loadCatalogForBuild();
  if (list.status !== "ok") return [];
  const source = sourceKind();
  const catalog = await getBuildSource();
  const types = typesWithResources(list.items);
  const paths = [];
  for (const summary of list.items.filter((r) => hasStaticPage(source, r))) {
    const detail = await catalog.detail(summary.type, summary.slug);
    if (detail.status === "ok") paths.push({ params: { tipo: TYPE_SEGMENT[summary.type], slug: summary.slug }, props: { resource: detail.resource, types } });
  }
  return paths;
}

const { resource, types } = Astro.props as { resource: ResourceDetail; types: import("../../../lib/marketplace-resources/types").ResourceType[] };
const source = sourceKind();
---

<CatalogShell
  title={`${resource.title} | Marketplace RUNLY`}
  description={resource.summary}
  path={resourcePath(resource.type, resource.slug).replace(/\/$/, "")}
  source={source}
  noindex={!pageIsIndexable(source, resource)}
  types={types}
  active={resource.type}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <ResourceDetailView resource={resource} hubUrl={import.meta.env.PUBLIC_RUNLY_HUB_URL} client:load />
  </div>
</CatalogShell>
