---
// src/pages/marketplace/[tipo]/index.astro
//
// One list page per resource type. getStaticPaths only emits types that have at
// least one available resource, so an empty type has no page and is not linked.
import CatalogShell from "../../../components/marketplace/resources/CatalogShell.astro";
import ResourceGallery from "../../../components/marketplace/resources/ResourceGallery";
import { typesWithResources } from "../../../lib/marketplace-resources/filters";
import { MARKETPLACE_BASE, TYPE_SEGMENT, pageIsIndexable } from "../../../lib/marketplace-resources/routes";
import { indexingAuthorized, loadCatalogForBuild, sourceKind } from "../../../lib/marketplace-resources/source";
import { T, TYPE_TEXT } from "../../../lib/marketplace-resources/text";
import type { ResourceSummary, ResourceType } from "../../../lib/marketplace-resources/types";

export const prerender = true;

export async function getStaticPaths() {
  const list = await loadCatalogForBuild();
  const items = list.status === "ok" ? list.items : [];
  return [...new Set(['studio_template' as ResourceType,...typesWithResources(items)])].map((type) => ({ params: { tipo: TYPE_SEGMENT[type] }, props: { type, items } }));
}

const { type, items } = Astro.props as { type: ResourceType; items: ResourceSummary[] };
const source = sourceKind();
const text = TYPE_TEXT[type];
---

<CatalogShell
  title={`${text.plural} | Marketplace RUNLY`}
  description={text.description}
  path={`${MARKETPLACE_BASE}/${TYPE_SEGMENT[type]}`}
  source={source}
  noindex={!pageIsIndexable(source, indexingAuthorized())}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header class="mb-6">
      <a href={`${MARKETPLACE_BASE}/`} class="text-sm font-semibold text-orange-600 hover:underline">&larr; {T.breadcrumbHome}</a>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{text.plural}</h1>
      <p class="mt-1.5 text-base text-slate-600">{text.description}</p>
    </header>
    {source === "hub"
      ? <ResourceGallery client:only="react" type={type} hubUrl={import.meta.env.PUBLIC_RUNLY_HUB_URL} syncUrl />
      : <ResourceGallery client:load type={type} initialItems={items} syncUrl />}
  </div>
</CatalogShell>
