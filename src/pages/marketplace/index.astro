---
// src/pages/marketplace/index.astro
//
// Runly Marketplace home: the public discovery page for the Runly ecosystem.
// Three clearly separated things are shown:
//   A. the official modules that ship with Runly (not installable packages),
//   B. community modules (Developer Hub directory, listed on /modulos),
//   C. Marketplace resources (Studio/Website templates, automations, Solutions).
// Static output: the catalog is read once at build time from the Developer Hub
// projections (or from clearly marked fixtures in local development). Types
// without published resources are described as "in preparation", never linked
// or counted; an unpublished or unreachable catalog renders an honest state.
import { Blocks, Users } from "@lucide/astro";
import CatalogShell from "../../components/marketplace/resources/CatalogShell.astro";
import RuntimeCatalog from "../../components/marketplace/resources/RuntimeCatalog";
import ResourceCatalog from "../../components/marketplace/resources/ResourceCatalog.astro";
import ResourceCard from "../../components/marketplace/resources/ResourceCard.astro";
import PublisherCard from "../../components/marketplace/resources/PublisherCard.astro";
import MarketplaceSearch from "../../components/marketplace/resources/MarketplaceSearch.astro";
import ResourceStateBlock from "../../components/marketplace/resources/ResourceStateBlock";
import { modules } from "../../data/modules";
import { resolveIcon } from "../../lib/icons";
import { publishersWithPages, typesWithResources } from "../../lib/marketplace-resources/filters";
import { hasStaticPage, pageIsIndexable, resourcePath, runtimeResourcePath, typePath } from "../../lib/marketplace-resources/routes";
import { indexingAuthorized, loadCatalogForBuild, sourceKind } from "../../lib/marketplace-resources/source";
import { T, TYPE_TEXT } from "../../lib/marketplace-resources/text";
import { RESOURCE_TYPES, type ResourceType } from "../../lib/marketplace-resources/types";

export const prerender = true;

const list = await loadCatalogForBuild();
const source = sourceKind();
const items = list.status === "ok" ? list.items : [];
const available = items.filter((r) => r.availability === "available");
const types = typesWithResources(items);
const publishers = publishersWithPages(items, source);
const official = modules.filter((m) => m.status === "disponible");
const ICON: Record<ResourceType, string> = { studio_template: "Palette", automation: "Workflow", website_template: "Globe", solution: "Package" };
const TINT: Record<ResourceType, string> = { studio_template: "bg-violet-50 text-violet-700", automation: "bg-amber-50 text-amber-700", website_template: "bg-sky-50 text-sky-700", solution: "bg-emerald-50 text-emerald-700" };
// Official first, then verified community; at most 3, only real available resources.
const rank = { official: 0, "community-verified": 1, community: 2, revoked: 3 } as const;
const featured = [...available].sort((a, b) => rank[a.trust] - rank[b.trust]).slice(0, 3);
const noindex = !pageIsIndexable(source, indexingAuthorized()) || items.length === 0;
const searchEntries = [
  ...official.map((m) => ({ kind: "Módulo oficial", title: m.name.es, text: m.description.es, href: `/documentacion/modulos/${m.id}` })),
  ...available.map((r) => ({ kind: TYPE_TEXT[r.type].singular, title: r.title, text: `${r.summary} ${r.publisher.displayName} ${r.categories.join(" ")}`, href: hasStaticPage(source, r) ? resourcePath(r.type, r.slug) : runtimeResourcePath(r.type, r.slug) })),
];
const steps = [
  ["Descubre", "Explora aquí los módulos y recursos, y revisa quién los publica y con qué nivel de confianza."],
  ["Instala desde Runly", "Descarga las plantillas Studio o importa una copia desde el Marketplace integrado en tu instancia."],
  ["Revisa y activa", "Antes de aplicarse ves lo que va a hacer. Las automatizaciones se importan en pausa."],
];
---

<CatalogShell
  title="Marketplace de recursos | RUNLY"
  description="Plantillas Studio, automatizaciones, plantillas Website y Solutions para Runly, publicadas por Runly y por la comunidad."
  path="/marketplace"
  source={source}
  noindex={noindex}
  types={types}
  active="overview"
>
  <section class="relative border-b border-slate-200 bg-grid-pattern">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-widest text-orange-600">{T.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Todo lo que puedes sumar a tu operación en Runly</h1>
      <p class="mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">Módulos oficiales, catálogo comunitario de módulos y recursos listos para usar: plantillas, automatizaciones y Solutions. Descubre qué hay, quién lo publica y cómo usarlo dentro de Runly.</p>
      <div class="mt-8"><MarketplaceSearch entries={searchEntries} /></div>
      <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
        <a class="text-orange-600 hover:underline" href="/modulos">Ver los módulos oficiales</a>
        <a class="text-orange-600 hover:underline" href="/documentacion/modulos">Documentación</a>
        <a class="text-orange-600 hover:underline" href="/runly-developer">Publicar en Runly</a>
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <section aria-labelledby="explorar">
      <h2 id="explorar" class="text-2xl font-extrabold tracking-tight text-slate-900">Explora por categoría</h2>

      <h3 class="mt-6 text-sm font-bold uppercase tracking-wider text-slate-500">La plataforma</h3>
      <p class="mt-1 max-w-2xl text-sm text-slate-600">Los módulos vienen con Runly y se activan en tu instancia. No son paquetes del Marketplace.</p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        <li>
          <a href="/modulos" class="group flex h-full gap-4 rounded-3xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-glass focus-visible:border-orange-400">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-orange-50 text-orange-600"><Blocks class="h-6 w-6" aria-hidden="true" /></span>
            <span class="min-w-0"><span class="block font-bold text-slate-900 group-hover:text-orange-600">Módulos oficiales de Runly</span><span class="mt-1 block text-sm text-slate-600">Contactos, inventario, finanzas, proyectos, chat y más, con documentación de cada uno.</span><span class="mt-2 block text-xs font-semibold text-slate-500">{official.length} módulos disponibles</span></span>
          </a>
        </li>
        <li>
          <a href="/modulos#marketplace" class="group flex h-full gap-4 rounded-3xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-glass focus-visible:border-orange-400">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-slate-100 text-slate-700"><Users class="h-6 w-6" aria-hidden="true" /></span>
            <span class="min-w-0"><span class="block font-bold text-slate-900 group-hover:text-orange-600">Catálogo comunitario de módulos</span><span class="mt-1 block text-sm text-slate-600">Módulos publicados en Developer Hub por Runly y por la comunidad, cada uno con su nivel de confianza.</span><span class="mt-2 block text-xs font-semibold text-slate-500">Directorio en el catálogo de módulos</span></span>
          </a>
        </li>
      </ul>

      {source === "fixtures" && <><h3 class="mt-10 text-sm font-bold uppercase tracking-wider text-slate-500">Recursos del Marketplace</h3>
      <p class="mt-1 max-w-2xl text-sm text-slate-600">Piezas listas para usar que se instalan desde Runly y se revisan antes de aplicarse.</p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {RESOURCE_TYPES.map((type) => {
          const Icon = resolveIcon(ICON[type]);
          const count = available.filter((r) => r.type === type).length;
          const live = count > 0;
          const body = (
            <>
              <span class={`flex h-11 w-11 items-center justify-center rounded-2xl ${TINT[type]}`}><Icon class="h-5 w-5" aria-hidden="true" /></span>
              <span class="font-bold text-slate-900 group-hover:text-orange-600">{TYPE_TEXT[type].plural}</span>
              <span class="flex-1 text-sm text-slate-600">{TYPE_TEXT[type].description}</span>
              <span class={`w-fit rounded-full px-2.5 py-1 text-[11px] font-semibold ${live ? "bg-slate-100 text-slate-600" : "bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-200"}`}>{live ? T.results(count) : "En preparación"}</span>
            </>
          );
          return (
            <li>
              {live
                ? <a href={typePath(type)} class="group flex h-full flex-col gap-3 rounded-3xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-glass focus-visible:border-orange-400">{body}</a>
                : <div class="flex h-full flex-col gap-3 rounded-3xl border border-dashed border-slate-300 bg-slate-50/60 p-5">{body}</div>}
            </li>
          );
        })}
      </ul></>}
    </section>

    {source === "hub" && <RuntimeCatalog client:only="react" hubUrl={import.meta.env.PUBLIC_RUNLY_HUB_URL}/> }
    {source === "fixtures" && <>
    {list.status !== "ok" && <div class="mt-14"><ResourceStateBlock kind="unavailable" /></div>}

    {list.status === "ok" && items.length === 0 && (
      <section class="mt-14 rounded-3xl border border-orange-200 bg-gradient-to-br from-orange-50 to-white p-6 sm:p-10" aria-labelledby="preparacion" data-launch-state>
        <p class="text-xs font-bold uppercase tracking-widest text-orange-600">Lanzamiento</p>
        <h2 id="preparacion" class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">El catálogo de recursos está en preparación</h2>
        <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">Todavía no hay recursos publicados. Cuando se publique el primero aparecerá aquí, con su publicador y su nivel de confianza. Mientras tanto puedes:</p>
        <ul class="mt-5 flex flex-wrap gap-3 text-sm font-semibold">
          <li><a class="inline-flex rounded-full bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" href="/modulos">Explorar los módulos oficiales</a></li>
          <li><a class="inline-flex rounded-full border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50" href="/documentacion/modulos">Leer la documentación</a></li>
          <li><a class="inline-flex rounded-full border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50" href="/runly-developer">Publicar el primer recurso</a></li>
        </ul>
      </section>
    )}

    {featured.length > 0 && (
      <section class="mt-14" aria-labelledby="destacados">
        <h2 id="destacados" class="text-2xl font-extrabold tracking-tight text-slate-900">Para empezar</h2>
        <p class="mt-1 text-sm text-slate-600">Primero los publicados por Runly, luego los de la comunidad verificada.</p>
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((resource) => <ResourceCard resource={resource} source={source} />)}
        </div>
      </section>
    )}

    {items.length > 0 && (
      <section class="mt-14 scroll-mt-24" aria-labelledby="catalogo-titulo" id="catalogo">
        <h2 id="catalogo-titulo" class="mb-5 text-2xl font-extrabold tracking-tight text-slate-900">Todo el catálogo</h2>
        <ResourceCatalog items={items} source={source} />
      </section>
    )}

    {publishers.length > 0 && (
      <section class="mt-16" aria-labelledby="publicadores">
        <h2 id="publicadores" class="text-2xl font-extrabold tracking-tight text-slate-900">{T.publishers}</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {publishers.map(({ publisher, count }) => <li><PublisherCard publisher={publisher} count={count} /></li>)}
        </ul>
      </section>
    )}

    </>}
    <section class="mt-16" aria-labelledby="como-funciona">
      <h2 id="como-funciona" class="text-2xl font-extrabold tracking-tight text-slate-900">Cómo funciona</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-3">
        {steps.map(([title, body], i) => (
          <li class="rounded-3xl border border-slate-200 bg-white p-5">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
            <p class="mt-3 font-bold text-slate-900">{title}</p>
            <p class="mt-1 text-sm text-slate-600">{body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-slate-500">{T.footerNote}</p>
    </section>

    <section class="mt-16 flex flex-col items-start justify-between gap-5 rounded-3xl bg-slate-900 p-6 text-white sm:flex-row sm:items-center sm:p-8" aria-label="Siguientes pasos">
      <div class="max-w-xl">
        <p class="text-xl font-extrabold">¿Quieres verlo funcionando en tu empresa?</p>
        <p class="mt-1 text-sm text-slate-300">Te mostramos Runly con tus procesos y te ayudamos a elegir los módulos y recursos adecuados.</p>
      </div>
      <div class="flex flex-wrap gap-3 text-sm font-semibold">
        <a class="runly-gradient-btn inline-flex rounded-xl px-5 py-2.5 text-white" href="/#contacto">Solicitar una demostración</a>
        <a class="inline-flex rounded-xl border border-white/30 px-5 py-2.5 hover:bg-white/10" href="/">Conocer Runly ERP</a>
      </div>
    </section>
  </div>
</CatalogShell>
