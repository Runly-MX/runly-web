---
// src/pages/marketplace/index.astro
//
// Marketplace home: a compact heading and the resource gallery. The explanatory
// copy (what it is, how it works, module links) lives in the gallery's "Acerca
// del Marketplace" side panel. Hub data is read in the browser (so releases
// published after the build appear); fixtures render at build time for local dev.
import CatalogShell from "../../components/marketplace/resources/CatalogShell.astro";
import ResourceGallery from "../../components/marketplace/resources/ResourceGallery";
import { pageIsIndexable } from "../../lib/marketplace-resources/routes";
import { indexingAuthorized, loadCatalogForBuild, sourceKind } from "../../lib/marketplace-resources/source";

export const prerender = true;

const list = await loadCatalogForBuild();
const source = sourceKind();
const items = list.status === "ok" ? list.items : [];
const noindex = !pageIsIndexable(source, indexingAuthorized()) || items.length === 0;
---

<CatalogShell
  title="Marketplace de recursos | RUNLY"
  description="Plantillas Studio, automatizaciones, plantillas Website y Solutions para Runly, publicadas por Runly y por la comunidad."
  path="/marketplace"
  source={source}
  noindex={noindex}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header class="mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Marketplace</h1>
      <p class="mt-1.5 text-base text-slate-600">Plantillas, automatizaciones y Solutions para Runly.</p>
    </header>
    {source === "hub"
      ? <ResourceGallery client:only="react" hubUrl={import.meta.env.PUBLIC_RUNLY_HUB_URL} syncUrl />
      : <ResourceGallery client:load initialItems={items} syncUrl />}
  </div>
</CatalogShell>
