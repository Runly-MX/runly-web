---
// src/pages/marketplace/publicadores/[handle].astro
//
// Resolve the registered publisher on every request, including after the site build.
import ResourceStateBlock from "../../../components/marketplace/resources/ResourceStateBlock";
import CatalogShell from "../../../components/marketplace/resources/CatalogShell.astro";
import ResourceGallery from "../../../components/marketplace/resources/ResourceGallery";
import { Avatar } from "../../../components/marketplace/resources/parts";
import { Icon } from "../../../components/marketplace/resources/icons";
import { typesWithResources } from "../../../lib/marketplace-resources/filters";
import { TYPE_TEXT } from "../../../lib/marketplace-resources/text";
import { MARKETPLACE_BASE, pageIsIndexable, publisherPath } from "../../../lib/marketplace-resources/routes";
import { indexingAuthorized, getBuildSource, sourceKind } from "../../../lib/marketplace-resources/source";
import { T } from "../../../lib/marketplace-resources/text";

export const prerender = false;

const result = await (await getBuildSource()).publisher(Astro.params.handle ?? '');
const profile = result.status === 'ok' ? result.publisher : null;
const items = result.status === 'ok' ? result.items : [];
const types = typesWithResources(items);
const source = sourceKind();
Astro.response.status = result.status === 'not_found' ? 404 : result.status === 'unavailable' ? 503 : profile?.state === 'revoked' ? 410 : 200;
Astro.response.headers.set('Cache-Control', 'no-store');
const kind = result.status === 'not_found' ? 'not_found' : profile?.state === 'revoked' ? 'revoked' : 'unavailable';
const typeCounts = types.map((t) => ({ t, n: items.filter((r) => r.type === t && r.availability === "available").length }));
const since = new Date(profile?.memberSince ?? 0).toLocaleDateString("es-MX", { year: "numeric", month: "long", timeZone: "UTC" });
---

<CatalogShell
  title={`${profile?.displayName ?? "Publicador"} | Marketplace RUNLY`}
  description={T.resourcesBy(profile?.displayName ?? "Publicador")}
  path={publisherPath(Astro.params.handle ?? "").replace(/\/$/, "")}
  source={source}
  noindex={!pageIsIndexable(source, indexingAuthorized()) || !profile || profile.state === "revoked" || !items.some((r) => pageIsIndexable(source, true, r))}
>
  {profile && profile.state === "active" ? <>
  <section class="border-b border-slate-200 bg-gradient-to-b from-orange-50/70 to-transparent">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <a href={`${MARKETPLACE_BASE}/`} class="text-sm font-semibold text-orange-600 hover:underline">&larr; {T.breadcrumbHome}</a>
      <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-center">
        <Avatar name={profile.displayName} size="lg" />
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{profile.displayName}</h1>
            {profile.verified && <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200" data-publisher-verified><Icon name="check" className="h-3.5 w-3.5" />{T.verifiedPublisher}</span>}
          </div>
          <p class="mt-2 text-sm text-slate-600">{T.memberSince} {since} · {T.results(profile.resourceCount)}</p>
          {typeCounts.length > 0 && <ul class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-slate-700">{typeCounts.map(({ t, n }) => <li class="rounded-full bg-slate-100 px-2.5 py-1">{TYPE_TEXT[t].plural} · {n}</li>)}</ul>}
        </div>
      </div>
      {profile.bio && <p class="mt-5 max-w-2xl text-base text-slate-700">{profile.bio}</p>}
      <p class="mt-4 max-w-2xl text-xs text-slate-500">Un publicador identifica quién sube el recurso. No significa que sea oficial de Runly: la procedencia de cada recurso aparece en su tarjeta y en su ficha.</p>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h2 class="mb-5 text-xl font-bold text-slate-900">{T.resourcesBy(profile.displayName)}</h2>
    <ResourceGallery client:load initialItems={items} />
  </div>
  </> : <ResourceStateBlock kind={kind} showBack />}
</CatalogShell>
