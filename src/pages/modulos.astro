---
// src/pages/modulos.astro
//
// Full module catalog page (the module card grid + filters + roadmap), split
// out of the homepage's ModulesCatalogSection so the landing page keeps a
// condensed teaser instead of every module. See
// src/components/sections/ModulesFullCatalogSection.astro.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ModulesFullCatalogSection from "../components/sections/ModulesFullCatalogSection.astro";
import { getDictionary } from "../i18n";
import MarketplaceDirectorySection from "../components/marketplace/MarketplaceDirectorySection.astro";
import { loadDirectoryForBuild } from "../lib/marketplace-build";
import { MARKETPLACE_TEXT } from "../lib/marketplace";

export const prerender = true;

const locale = "es" as const;
const dict = getDictionary(locale);
const { modulesPage } = dict;
// Marketplace modules come from Developer Hub (source of truth); the built-in
// list below describes what ships inside Runly and is not a distribution catalog.
const directory = await loadDirectoryForBuild();
const marketplace = MARKETPLACE_TEXT[locale];
---

<BaseLayout title={modulesPage.metaTitle} description={modulesPage.metaDescription} locale={locale} path="/modulos">
  <Header locale={locale} nav={dict.nav} />
  <main class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/" class="text-sm font-semibold text-orange-600 hover:underline">&larr; {modulesPage.backToHome}</a>
      <div class="mt-6">
        <SectionHeading eyebrow={modulesPage.eyebrow} title={modulesPage.title} description={modulesPage.description} />
      </div>
      <nav aria-label="Secciones del catálogo" class="mt-6 flex flex-wrap justify-center gap-2 text-sm font-semibold">
        <a href="#oficiales" class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-slate-200">Módulos oficiales</a>
        <a href="#marketplace" class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-slate-200">Catálogo comunitario de módulos</a>
        <a href="/marketplace/" class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-slate-200">Plantillas y automatizaciones &rarr;</a>
      </nav>
      <h2 id="oficiales" class="mb-2 mt-10 scroll-mt-24 text-center text-xl font-bold text-slate-900">{marketplace.builtInTitle}</h2>
      <p class="mx-auto mb-8 max-w-2xl text-center text-sm text-slate-600">{marketplace.builtInDescription}</p>
      <ModulesFullCatalogSection dict={dict} locale={locale} />
      <MarketplaceDirectorySection locale={locale} directory={directory} />
    </div>
  </main>
  <Footer locale={locale} footer={dict.footer} />
</BaseLayout>
